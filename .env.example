# Local development compatibility until the hosted Supabase cutover is verified.
AUTH_PROVIDER=better-auth
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://encova:local_only@localhost:5432/encova_dev
# Production: Supavisor transaction pooler (:6543) above; direct/session pooler
# (:5432) for controlled migration commands below. URL-encode passwords.
# DIRECT_URL=postgresql://migration-user:password@migration-host:5432/postgres
DATABASE_POOL_MAX=2

# Supabase production auth. All clients run on the server; no secret is public.
# AUTH_PROVIDER=supabase
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=your-project-publishable-key
# SUPABASE_SECRET_KEY=your-server-only-secret-key
SUPABASE_STORAGE_BUCKET=encova-private
# CRON_SECRET=generate-a-random-secret-at-least-32-characters

# Legacy local development only; rejected for Vercel production deployments.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=workspace@example.test
SMTP_USER=
SMTP_PASSWORD=
