# Local development compatibility until the hosted Supabase cutover is verified.
AUTH_PROVIDER=better-auth
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://encova:local_only@localhost:5432/encova_dev
# Production: Supavisor transaction pooler (:6543) above; direct/session pooler
# (:5432) for controlled migration commands below. URL-encode passwords.
# DIRECT_URL=postgresql://migration-user:password@migration-host:5432/postgres
DATABASE_POOL_MAX=2
# Hosted provider CA certificate (PEM) for verified TLS, if required by the project.
# DATABASE_SSL_CA=the-project-ca-certificate-pem

# Supabase production auth. All clients run on the server; no secret is public.
# AUTH_PROVIDER=supabase
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=your-project-publishable-key
# SUPABASE_SECRET_KEY=your-server-only-secret-key
SUPABASE_STORAGE_BUCKET=encova-private
# CRON_SECRET=generate-a-random-secret-at-least-32-characters

# Legacy local development only; rejected for Vercel production deployments.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=workspace@example.test
SMTP_USER=
SMTP_PASSWORD=
# Resend: SMTP_HOST=smtp.resend.com, SMTP_PORT=465, SMTP_USER=resend,
# SMTP_FROM=workspace@your-verified-domain.com, SMTP_PASSWORD=server-only API key.
# Configure the same SMTP provider separately in Supabase Auth for resets.
# Required when using Resend's onboarding@resend.dev test sender:
# SMTP_TEST_RECIPIENT=your-resend-account-email
# Enable only after verified-domain Auth SMTP, dual-email confirmation and
# the exact email-change callback are configured and inbox-tested.
EMAIL_CHANGE_ENABLED=false
