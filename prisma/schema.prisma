generator client {
 provider = "prisma-client"
 output = "../src/generated/prisma"
}
datasource db {
 provider = "postgresql"
}
model User {
 id String @id
 name String
 email String @unique
 emailVerified Boolean @default(false)
 image String?
 createdAt DateTime @default(now()) @db.Timestamptz
 updatedAt DateTime @updatedAt @db.Timestamptz
 sessions Session[]
 accounts Account[]
 person Person?
 @@map("user")
}
model Session {
 id String @id
 expiresAt DateTime @db.Timestamptz
 token String @unique
 createdAt DateTime @default(now()) @db.Timestamptz
 updatedAt DateTime @updatedAt @db.Timestamptz
 ipAddress String?
 userAgent String?
 userId String
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 @@index([userId])
 @@map("session")
}
model Account {
 id String @id
 accountId String
 providerId String
 userId String
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 accessToken String?
 refreshToken String?
 idToken String?
 accessTokenExpiresAt DateTime? @db.Timestamptz
 refreshTokenExpiresAt DateTime? @db.Timestamptz
 scope String?
 password String?
 createdAt DateTime @default(now()) @db.Timestamptz
 updatedAt DateTime @updatedAt @db.Timestamptz
 @@index([userId])
 @@map("account")
}
model Verification {
 id String @id
 identifier String
 value String
 expiresAt DateTime @db.Timestamptz
 createdAt DateTime @default(now()) @db.Timestamptz
 updatedAt DateTime @updatedAt @db.Timestamptz
 @@index([identifier])
 @@map("verification")
}
enum Role {
 SUPER_ADMIN
 HR_ADMIN
 TEAM_LEAD
 MEMBER
}
enum PersonStatus {
 INVITED
 ACTIVE
 INACTIVE
}
enum TaskStatus {
 ASSIGNED
 IN_PROGRESS
 BLOCKED
 IN_REVIEW
 CHANGES_REQUESTED
 APPROVED
 CANCELED
}
model Person {
 createdFinanceAssets FinanceAsset[] @relation("FinanceAssetCreator")
 custodyFinanceAssets FinanceAsset[] @relation("FinanceAssetCustodian")
 financeInvestmentHoldings FinanceInvestmentHolding[]
 financeLoans FinanceLoan[]
 financeMovements FinanceMovement[]
 financeFiles FinanceFile[] @relation("FileUploader")
 financeScanAuthorities FinanceScanAuthority[]
 financeFileIntents FinanceFile[] @relation("FileIntentActor")
 financeTaxCodes FinanceTaxCode[]
 supplierDocuments FinanceSupplierDocument[]
 financeBills FinanceBill[]
 customerDocuments FinanceCustomerDocument[]
 id String @id @default(uuid()) @db.Uuid
 supabaseUserId String? @unique @db.Uuid
 authUserId String? @unique
 authUser User? @relation(fields:[authUserId],references:[id])
 email String @unique
 username String @unique
 displayName String
 role Role @default(MEMBER)
 status PersonStatus @default(INVITED)
 employmentType String @default("EMPLOYEE")
 version Int @default(1)
 createdAt DateTime @default(now()) @db.Timestamptz
 updatedAt DateTime @updatedAt @db.Timestamptz
 projects Project[]
 memberships ProjectMember[]
 assignments Task[] @relation("Assignee")
 reviews Task[] @relation("Reviewer")
 submissions Submission[]
 attachments Attachment[]
 decisions Review[]
 appSessions AppSession[]
 notifications Notification[]
 financeGrants FinanceGrant[] @relation("FinanceGrantee")
 issuedFinanceGrants FinanceGrant[] @relation("FinanceGrantIssuer")
 revokedFinanceGrants FinanceGrant[] @relation("FinanceGrantRevoker")
 financeAuditEvents FinanceAuditEvent[]
 financeOwnership FinanceSettings?
 financeAccessReceipts FinanceAccessReceipt[]
 financeSetupReceipts FinanceSetupReceipt[]
 financeClosedPeriods FinancePeriod[] @relation("FinancePeriodCloser")
 financeJournalDrafts FinanceJournalDraft[]
 financeJournalEntries FinanceJournalEntry[]
 financeLedgerReceipts FinanceLedgerReceipt[]
 financeParties FinanceParty[]
 financeInvoices FinanceInvoice[]
 @@index([status,role])
}

// No public/admin endpoint may create these grants through generic Person updates.
model FinanceGrant {
 id String @id @default(uuid()) @db.Uuid
 userId String @db.Uuid
 user Person @relation("FinanceGrantee",fields:[userId],references:[id],onDelete:Restrict)
 grantedById String @db.Uuid
 grantedBy Person @relation("FinanceGrantIssuer",fields:[grantedById],references:[id],onDelete:Restrict)
 grantedAt DateTime @default(now()) @db.Timestamptz
 revokedById String? @db.Uuid
 revokedBy Person? @relation("FinanceGrantRevoker",fields:[revokedById],references:[id],onDelete:Restrict)
 revokedAt DateTime? @db.Timestamptz
 reason String
 version Int @default(1)
 ownership FinanceSettings?
 @@unique([id,userId])
 @@index([userId,revokedAt])
}

model FinanceSettings {
 id String @id @default("00000000-0000-0000-0000-000000000001") @db.Uuid
 ownerId String @unique @db.Uuid
 owner Person @relation(fields:[ownerId],references:[id],onDelete:Restrict)
 ownerGrantId String @unique @db.Uuid
 ownerGrant FinanceGrant @relation(fields:[ownerGrantId],references:[id],onDelete:Restrict)
 currency String @default("PKR")
 version Int @default(1)
 createdAt DateTime @default(now()) @db.Timestamptz
 updatedAt DateTime @default(now()) @db.Timestamptz
}

model FinanceOwnershipTransfer {
 id String @id @default(uuid()) @db.Uuid
 currentOwnerId String @db.Uuid
 targetOwnerId String @db.Uuid
 status String @default("PENDING")
 reason String
 version Int @default(1)
 expiresAt DateTime @db.Timestamptz
 acceptedAt DateTime? @db.Timestamptz
 createdAt DateTime @default(now()) @db.Timestamptz
 @@index([targetOwnerId,status])
}

model FinanceAccessReceipt {
 id String @id @default(uuid()) @db.Uuid
 actorId String @db.Uuid
 actor Person @relation(fields:[actorId],references:[id],onDelete:Restrict)
 operation String
 key String
 requestHash String
 result Json
 createdAt DateTime @default(now()) @db.Timestamptz
 @@unique([actorId,operation,key])
}

model FinanceAuditEvent {
 id String @id @default(uuid()) @db.Uuid
 actorId String @db.Uuid
 actor Person @relation(fields:[actorId],references:[id],onDelete:Restrict)
 action String
 entityType String
 entityId String? @db.Uuid
 reason String
 data Json
 requestId String @db.Uuid
 createdAt DateTime @default(now()) @db.Timestamptz
 @@index([entityType,entityId,createdAt])
 @@index([actorId,createdAt])
}

model FinanceAccount {
 registeredAssets FinanceAsset[]
 investmentHoldings FinanceInvestmentHolding[] @relation("HoldingInvestment")
gainHoldings FinanceInvestmentHolding[] @relation("HoldingGain")
lossHoldings FinanceInvestmentHolding[] @relation("HoldingLoss")
feeHoldings FinanceInvestmentHolding[] @relation("HoldingFee")
incomeHoldings FinanceInvestmentHolding[] @relation("HoldingIncome")
incomeControlHoldings FinanceInvestmentHolding[] @relation("HoldingIncomecontrol")
valuationOffsetHoldings FinanceInvestmentHolding[] @relation("HoldingValuationoffset")
impairmentHoldings FinanceInvestmentHolding[] @relation("HoldingImpairment")
 principalLoans FinanceLoan[] @relation("LoanPrincipal")
 interestLoans FinanceLoan[] @relation("LoanInterest")
 resultLoans FinanceLoan[] @relation("LoanResult")
 fundingEvents FinanceFundingEvent[]
 controlMovements FinanceMovement[] @relation("MovementControl")
 counterMovements FinanceMovement[] @relation("MovementCounter")
 inputTaxCodes FinanceTaxCode[] @relation("TaxInput")
 outputTaxCodes FinanceTaxCode[] @relation("TaxOutput")
 taxedInvoiceLines FinanceInvoiceLine[] @relation("FinanceInvoiceLineTax")
 taxedBillLines FinanceBillLine[] @relation("FinanceBillLineTax")
 withheldCustomerDocuments FinanceCustomerDocument[] @relation("FinanceCustomerDocumentWithholding")
 withheldSupplierDocuments FinanceSupplierDocument[] @relation("FinanceSupplierDocumentWithholding")
 creditTaxSplits FinanceCreditTaxSplit[]

 supplierBalanceEvents FinanceSupplierBalanceEvent[]
 supplierAdvanceDocuments FinanceSupplierDocument[] @relation("SupplierAdvanceAccount")
 supplierFeeDocuments FinanceSupplierDocument[] @relation("SupplierFeeAccount")
 payableBills FinanceBill[] @relation("BillPayable")
 costBillLines FinanceBillLine[] @relation("BillCost")
 payableEvents FinancePayableEvent[]
 clientBalanceEvents FinanceClientBalanceEvent[]
 customerAdvanceDocuments FinanceCustomerDocument[] @relation("CustomerAdvanceAccount")
 customerFeeDocuments FinanceCustomerDocument[] @relation("CustomerFeeAccount")
 id String @id @default(uuid()) @db.Uuid
 code String @unique
 name String
 type String
 normalSide String
 reportGroup String
 controlType String @default("NONE")
 currency String @default("PKR")
 parentId String? @db.Uuid
 parent FinanceAccount? @relation("FinanceAccountTree",fields:[parentId],references:[id],onDelete:Restrict,onUpdate:NoAction)
 children FinanceAccount[] @relation("FinanceAccountTree")
 journalDraftLines FinanceJournalDraftLine[]
 journalLines FinanceJournalLine[]
 cashAccount FinanceCashAccount?
 receivableInvoices FinanceInvoice[] @relation("InvoiceReceivables")
 revenueInvoiceLines FinanceInvoiceLine[] @relation("InvoiceRevenue")
 deferredInvoiceLines FinanceInvoiceLine[] @relation("InvoiceDeferred")
 receivableEvents FinanceReceivableEvent[]
 isPosting Boolean @default(true)
 isContra Boolean @default(false)
 isCashEquivalent Boolean @default(false)
 active Boolean @default(true)
 usedAt DateTime? @db.Timestamptz
 version Int @default(1)
 createdAt DateTime @default(now()) @db.Timestamptz
 updatedAt DateTime @default(now()) @db.Timestamptz
 @@index([active,type,code])
 @@index([parentId])
}

model FinancePeriod {
 id String @id @default(uuid()) @db.Uuid
 name String
 startDate DateTime @db.Date
 endDate DateTime @db.Date
 state String @default("OPEN")
 usedAt DateTime? @db.Timestamptz
 closedAt DateTime? @db.Timestamptz
 closedById String? @db.Uuid
 closedBy Person? @relation("FinancePeriodCloser",fields:[closedById],references:[id],onDelete:Restrict,onUpdate:NoAction)
 journals FinanceJournalEntry[]
 version Int @default(1)
 createdAt DateTime @default(now()) @db.Timestamptz
 updatedAt DateTime @default(now()) @db.Timestamptz
 @@index([state,startDate,id])
}

model FinanceSetupReceipt {
 id String @id @default(uuid()) @db.Uuid
