 billCreditEvents FinanceBillCreditEvent[]
 supplierBalanceEvents FinanceSupplierBalanceEvent[]
 supplierDocumentId String? @unique @db.Uuid
 supplierDocument FinanceSupplierDocument? @relation(fields:[supplierDocumentId],references:[id],onDelete:Restrict,onUpdate:NoAction)
 billId String? @unique @db.Uuid
 bill FinanceBill? @relation(fields:[billId],references:[id],onDelete:Restrict,onUpdate:NoAction)
 payableEvents FinancePayableEvent[]

 invoiceCreditEvents FinanceInvoiceCreditEvent[]
 clientBalanceEvents FinanceClientBalanceEvent[]
 customerDocumentId String? @unique @db.Uuid
 customerDocument FinanceCustomerDocument? @relation(fields:[customerDocumentId],references:[id],onDelete:Restrict,onUpdate:NoAction)

 id String @id @default(uuid()) @db.Uuid
 reference String @unique
 sourceType String
 sourceId String @db.Uuid
 sourceAction String
 draftId String? @unique @db.Uuid
 draft FinanceJournalDraft? @relation(fields:[draftId],references:[id],onDelete:Restrict,onUpdate:NoAction)
 invoiceId String? @unique @db.Uuid
 invoice FinanceInvoice? @relation(fields:[invoiceId],references:[id],onDelete:Restrict,onUpdate:NoAction)
 postingDate DateTime @db.Date
 periodId String @db.Uuid
 period FinancePeriod @relation(fields:[periodId],references:[id],onDelete:Restrict,onUpdate:NoAction)
 description String
